# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Nothing in this repo reads a key from disk; providers read the environment only.

# --- LLM provider for the triage agent -------------------------------------
# Only needed to run the agent live or to record cassettes. The analyzer, the
# eval, the sweeps and CI all run without any of this.

# z.ai (GLM) — dev default. Confirm the base URL and model in z.ai's docs.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.6

# Azure AI Foundry / Azure OpenAI — an OpenAI-compatible endpoint.
AZURE_AI_API_KEY=
AZURE_AI_BASE_URL=
AZURE_AI_MODEL=

# Which real provider `--record` records through.
RECORD_PROVIDER=zai

# --- Azure ------------------------------------------------------------------
# Passed on the command line to scripts/deploy-azure.ps1, not read from here.
# AZURE_SUBSCRIPTION_ID=
